// --- ZIP LOAD CONFIGURATION ---

// P_FRAC: The fraction of the load that behaves as constant power (independent of voltage).
// I_FRAC: The fraction of the load that behaves as constant current (scales linearly with voltage).
// Z_FRAC: The fraction of the load that behaves as constant impedance (scales with the square of voltage).
// PF_VAL: The power factor applied to the load (set to 0.95 lagging for all cases)[cite: 8].

#define PF_VAL=0.95

// --- CASE 1: Constant Power ---
#define P_FRAC=1.0
#define I_FRAC=0.0
#define Z_FRAC=0.0

// --- CASE 2: Constant Current ---
//#define P_FRAC=0.0
//#define I_FRAC=1.0
//#define Z_FRAC=0.0

// --- CASE 3: Constant Impedance ---
//#define P_FRAC=0.0
//#define I_FRAC=0.0
//#define Z_FRAC=1.0

// --- CASE 4: Mixed (40% Impedance, 30% Current, 30% Power)[cite: 8] ---
//#define P_FRAC=0.3
//#define I_FRAC=0.3
//#define Z_FRAC=0.4

// --- WATER HEATER CONFIGURATION ---
#define WH_LOCATION=INSIDE  // Indoor location
#define WH_SETPOINT=120     // Tank temperature setpoint in degrees Fahrenheit (°F)
#define WH_DEADBAND=2       // Thermostat deadband in degrees Fahrenheit (°F)
#define WH_VOL=50           // Tank volume in gallons
#define WH_CAPACITY=4.5     // Heating element capacity in kilowatts (kW)
#define WH_INLET=60         // Inlet water temperature in degrees Fahrenheit (°F)
#define WH_UA=3.3           // Tank overall heat transfer coefficient (UA) in Btu/(h·°F)

